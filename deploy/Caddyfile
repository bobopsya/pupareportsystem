# HTTPS certificate is issued automatically by Let's Encrypt for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy app:8080
}

# GPAY payment system (profile "gpay"). Without it this site just answers 502.
{$GPAY_DOMAIN:pay.localhost} {
	encode zstd gzip
	# Bank ↔ GPAY calls go over the docker network only.
	respond /internal/* 404
	reverse_proxy gpay:8081
}

# Bobobank game bank (profile "bobobank").
{$BANK_DOMAIN:bank.localhost} {
	encode zstd gzip
	respond /internal/* 404
	reverse_proxy bobobank:8082
}

# Бобуслуги (profile "bobuslugi").
{$GOS_DOMAIN:gos.localhost} {
	encode zstd gzip
	reverse_proxy bobuslugi:80
}

# Бобо.Транспорт (profile "transport").
{$TAXI_DOMAIN:taxi.localhost} {
	encode zstd gzip
	reverse_proxy transport:8084
}

# Бобтелеком (profile "telecom").
{$TELECOM_DOMAIN:telecom.localhost} {
	encode zstd gzip
	reverse_proxy telecom:8085
}
